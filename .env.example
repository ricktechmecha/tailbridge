# tailbridge — copia este archivo a .env y rellena con TUS datos.
# .env está en .gitignore y NUNCA se sube.

# --- HUB (tu computadora principal: Mac o Linux) ---
HUB_IP=100.x.x.x            # IP de Tailscale del hub
HUB_USER=tu_usuario
HUB_PORT=22

# --- NODE (el equipo remoto: Android/Termux, proot o Linux) ---
NODE_IP=100.y.y.y           # IP de Tailscale del nodo
NODE_USER=tu_usuario        # en Termux suele ser u0_aXXX
NODE_PORT=8022              # Termux=8022, Linux normal=22
NODE_KIND=termux            # termux | proot | linux

# --- Carpeta de intercambio compartida en el hub ---
SHARED_DIR=$HOME/tailbridge-shared
